    {
      "id": "tab_sync_pipeline",
      "title": "3. Offline-First Sync Architecture",
      "type": "flowchart",
      "transform": { "x": 60, "y": 30, "scale": 0.95 },
      "nodes": [
        {
          "id": "node_s_action",
          "type": "start",
          "label": "Local Mutation Triggered",
          "description": "User creates a new habit, reschedules time-block, or checks off items",
          "position": { "x": 360, "y": 60 },
          "colorTheme": "indigo"
        },
        {
          "id": "node_s_queue",
          "type": "process",
          "label": "Append to Local SQLite Queue",
          "description": "Persists mutation with client-side UUID, timestamp, and pending status",
          "position": { "x": 360, "y": 200 },
          "colorTheme": "blue"
        },
        {
          "id": "node_s_network",
          "type": "decision",
          "label": "Network Online?",
          "description": "Checks device connectivity via NetInfo event listener",
          "position": { "x": 360, "y": 340 },
          "colorTheme": "amber"
        },
        {
          "id": "node_s_offline",
          "type": "process",
          "label": "Store in Offline Outbox",
          "description": "App continues working 100% offline; registers background sync task",
          "position": { "x": 100, "y": 480 },
          "colorTheme": "slate"
        },
        {
          "id": "node_s_batch",
          "type": "process",
          "label": "Dispatch Batch Sync Request",
          "description": "Packages pending mutation queue into compressed JSON payload",
          "position": { "x": 360, "y": 480 },
          "colorTheme": "purple"
        },
        {
          "id": "node_s_server_valid",
          "type": "decision",
          "label": "Server Schema & Auth Valid?",
          "description": "Validates payload signature, JWT token, and idempotency key",
          "position": { "x": 360, "y": 620 },
          "colorTheme": "amber"
        },
        {
          "id": "node_s_retry",
          "type": "process",
          "label": "Exponential Backoff Retry",
          "description": "Handles 5xx rate limits or transient errors with jittered retry policy",
          "position": { "x": 620, "y": 620 },
          "colorTheme": "rose"
        },
        {
          "id": "node_s_commit",
          "type": "process",
          "label": "Commit to Postgres & Redis",
          "description": "Updates server record, writes audit log, and publishes WebSocket event",
          "position": { "x": 360, "y": 760 },
          "colorTheme": "cyan"
        },
        {
          "id": "node_s_end",
          "type": "end",
          "label": "Local Outbox Cleared",
          "description": "Marks local items as synced and notifies other devices via push",
          "position": { "x": 360, "y": 900 },
          "colorTheme": "emerald"
        }
      ],
      "edges": [
        {
          "id": "es_action_queue",
          "sourceNodeId": "node_s_action",
          "targetNodeId": "node_s_queue",
          "sourceAnchor": "bottom",
          "targetAnchor": "top",
          "label": "Write Ahead Log"
        },
        {
          "id": "es_queue_net",
          "sourceNodeId": "node_s_queue",
          "targetNodeId": "node_s_network",
          "sourceAnchor": "bottom",
          "targetAnchor": "top",
          "label": "Check Connection"
        },
        {
          "id": "es_net_offline",
          "sourceNodeId": "node_s_network",
          "targetNodeId": "node_s_offline",
          "sourceAnchor": "left",
          "targetAnchor": "top",
          "label": "Offline",
          "color": "#64748b"
        },
        {
          "id": "es_net_online",
          "sourceNodeId": "node_s_network",
          "targetNodeId": "node_s_batch",
          "sourceAnchor": "bottom",
          "targetAnchor": "top",
          "label": "Online",
          "color": "#10b981"
        },
        {
          "id": "es_offline_retry",
          "sourceNodeId": "node_s_offline",
          "targetNodeId": "node_s_batch",
          "sourceAnchor": "right",
          "targetAnchor": "left",
          "label": "On Reconnect"
        },
        {
          "id": "es_batch_valid",
          "sourceNodeId": "node_s_batch",
          "targetNodeId": "node_s_server_valid",
          "sourceAnchor": "bottom",
          "targetAnchor": "top",
          "label": "HTTPS POST /sync"
        },
        {
          "id": "es_valid_fail",
          "sourceNodeId": "node_s_server_valid",
          "targetNodeId": "node_s_retry",
          "sourceAnchor": "right",
          "targetAnchor": "left",
          "label": "503 / Network Error",
          "color": "#f43f5e"
        },
        {
          "id": "es_valid_ok",
          "sourceNodeId": "node_s_server_valid",
          "targetNodeId": "node_s_commit",
          "sourceAnchor": "bottom",
          "targetAnchor": "top",
          "label": "200 OK (Accepted)",
          "color": "#10b981"
        },
        {
          "id": "es_retry_batch",
          "sourceNodeId": "node_s_retry",
          "targetNodeId": "node_s_batch",
          "sourceAnchor": "top",
          "targetAnchor": "right",
          "label": "Retry Queue",
          "color": "#f59e0b"
        },
        {
          "id": "es_commit_end",
          "sourceNodeId": "node_s_commit",
          "targetNodeId": "node_s_end",
          "sourceAnchor": "bottom",
          "targetAnchor": "top",
          "label": "Sync Complete"
        }
      ]
    },
